[Unit]
Description=Portail de suivi des tournees Helios (HTTP 8080)
Documentation=file:///srv/helios/suivi
After=network.target
PartOf=helios.target

[Service]
Type=simple
User=helios-suivi
Group=helios-suivi
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /srv/helios/suivi/www
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# Ressources
MemoryMax=128M
CPUQuota=50%

# Durcissement : le serveur ne doit pouvoir écrire nulle part
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/tmp /var/tmp /run /dev/shm
PrivateIPC=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=helios.target
